exports[`reports a runtime symlink 1`] = `
"✗ Runtime directory has unsafe ownership, type, or permissions.
  Fix: Stop the daemon; restore your ownership and mode 0700 on its runtime directory. Do not use a symlink.
"
`;

exports[`reports an unidentified shell 1`] = `
"✗ The invoking shell could not be identified.
  Fix: Run doctor from zsh, fish, or bash after loading prefaix init.
"
`;

exports[`reports an uninspectable runtime path 1`] = `
"✗ Runtime directory cannot be inspected.
  Fix: Check directory access permissions, then rerun prefaix doctor.
"
`;

exports[`reports an uninspectable socket path 1`] = `
"✗ Daemon socket cannot be inspected.
  Fix: Check directory access permissions, then rerun prefaix doctor.
"
`;

exports[`reports an unloaded plugin 1`] = `
