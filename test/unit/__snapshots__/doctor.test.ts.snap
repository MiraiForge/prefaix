// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`closes a failed no-model session 1`] = `
"✗ pi RPC handshake or no-model probe failed.
  Fix: Check that pi starts in RPC mode; update or repair pi and rerun prefaix doctor.
"
`;

exports[`detects Forge initialization eval $(forge init zsh) 1`] = `
"✗ A Forge shell plugin may conflict with prefaix.
  Fix: Remove Forge initialization from the shell rc file, then restart the shell.
"
`;

exports[`detects Forge initialization plugins=(git forge) 1`] = `
"✗ A Forge shell plugin may conflict with prefaix.
  Fix: Remove Forge initialization from the shell rc file, then restart the shell.
"
`;

exports[`detects Forge initialization source /path/pi-zsh-plugin/plugin.zsh 1`] = `
"✗ A Forge shell plugin may conflict with prefaix.
  Fix: Remove Forge initialization from the shell rc file, then restart the shell.
"
`;

exports[`detects ble.sh initialization 1`] = `
"✗ ble.sh may conflict with prefaix's bash bindings.
  Fix: Disable ble.sh in the prefaix shell, then restart it.
"
`;

exports[`detects loaded Forge using the plugin marker 1`] = `
"✗ A Forge shell plugin may conflict with prefaix.
  Fix: Remove Forge initialization from the shell rc file, then restart the shell.
"
`;

exports[`detects loaded ble.sh using the plugin marker 1`] = `
"✗ ble.sh may conflict with prefaix's bash bindings.
  Fix: Disable ble.sh in the prefaix shell, then restart it.
"
`;

exports[`does not mistake a directory for a clipboard executable 1`] = `
