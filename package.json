{
  "name": "@miraiforge/prefaix",
  "version": "0.0.0",
  "private": true,
  "description": "PrefAIx — Forge-class : shell UX with a swappable AI agent backend (pi first)",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "prefaix": "dist/prefaix.js"
  },
  "packageManager": "bun@1.3.14",
  "scripts": {
    "build": "tsup",
    "check": "bun run lint && bun run typecheck && bun run test",
    "coverage": "vitest run --coverage",
    "docs:config": "bun scripts/config-reference.ts",
    "docs:check": "bun scripts/config-reference.ts --check",
    "test:perf": "bun run build && bun scripts/performance.ts",
    "spike:client-startup": "node scripts/spikes/client-startup.ts",
    "spike:rpc-live": "bun scripts/spikes/rpc-live.ts",
    "spike:rpc-controlled": "bun scripts/spikes/rpc-controlled.ts",
    "spike:m1-native": "bun scripts/spikes/m1-native.ts",
    "test:flake": "bun run build && node scripts/flake.mjs",
    "test:pi-smoke": "bun run build && bun scripts/pi-smoke.ts",
    "check:private": "node scripts/check-private.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0 && bun run format:check",
    "test": "vitest run",
    "test:contract": "vitest run test/contract",
    "test:e2e": "bun run build && vitest run --config vitest.e2e.config.ts",
    "test:iterm": "PREFAIX_ITERM=1 vitest run --config vitest.e2e.config.ts test/e2e/iterm.spec.ts",
    "test:unit": "vitest run test/unit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "smol-toml": "^1.9.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.4",
    "@vitest/coverage-v8": "5.0.1",
    "@xterm/headless": "6.0.0",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "node-pty": "1.2.0-beta.15",
    "prettier": "3.9.9",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MiraiForge/prefaix.git"
  },
  "homepage": "https://prefaix.dev",
  "bugs": {
    "url": "https://github.com/MiraiForge/prefaix/issues"
  },
  "keywords": [
    "ai",
    "shell",
    "zsh",
    "fish",
    "bash",
    "pi",
    "coding-agent",
    "cli"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
